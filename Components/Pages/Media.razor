@page "/media"
@rendermode InteractiveServer

<PageTitle>Media</PageTitle>

<h1>Média de notas</h1>

    <p>Primeira nota: @nota1  <br> Segunda nota: @nota2 </p>
    <input type="text" @bind="nota1" placeholder="Primeira nota"/>
    <input type="text" @bind="nota2" placeholder="Segunda nota"/>
    

<button @onclick="CalcularMedia">Calcular média</button>

<p> Média calculada: @media </p>

@if   (media >= 7.0)
{
    <p style="color: green;">Aprovado</p>
}
else
{
    <p style="color: red;">Reprovado</p>
}
@code {
    private double nota1, nota2, media;

    private void CalcularMedia()
    {
        media = nota1 + nota2 / 2;
    }
}
